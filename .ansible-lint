---
skip_list:
  - command-shell
  - ignore-errors
  - jinja[invalid]
  - key-order
  - literal-compare
  - name
  - no-changed-when
  - no-handler
  - risky-file-permissions
  - role-name
  - schema
  - var-naming[no-role-prefix]
  - var-naming[pattern]
  - yaml[quoted-strings]
  - yaml[line-length]

enable_list:
  - fqcn # opt-in

# The lab's infra playbooks use community.docker, which is installed in the molecule-runner image
# and not in the lint environment (the hook runs with --offline). Mocking the modules lets the
# rest of those playbooks be checked.
mock_modules:
  - community.docker.docker_container
  - community.docker.docker_network
  - community.docker.docker_volume
