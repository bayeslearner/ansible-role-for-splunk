# Optional settings for the lab. Copy to .env and uncomment what you need.

# Topology: small (default), dev, dms or prod
# MOLECULE_ENV=small

# Engine socket the runner mounts (default: Docker's)
# DOCKER_SOCK=/var/run/docker.sock

# Address the published ports (3000, 2222, 8929) bind to (default: this machine only)
# LAB_BIND_ADDRESS=127.0.0.1
