# Optional settings for the lab. Copy to .env and uncomment what you need.

# Topology: small (default), dev, dms or prod
# MOLECULE_ENV=small

# Engine socket the runner mounts (default: Docker's)
# DOCKER_SOCK=/var/run/docker.sock

# Address the published ports (3000, 2222, 8929) bind to (default: this machine only)
# LAB_BIND_ADDRESS=127.0.0.1

# Platform the lab's images are built and run as. Leave it: the role downloads Splunk's x86_64
# packages, so the images are amd64 on every host (emulated on an ARM machine).
# LAB_PLATFORM=linux/amd64

# Extra arguments for the runner container; needed where SELinux is enforcing.
# LAB_RUNNER_ARGS=--security-opt label=disable

# A second lab on the same engine: a name (lower-case letters and digits) and a port offset.
# Unset, the lab uses its plain names and ports 3000, 2222 and 8929.
# LAB_NAME=b
# LAB_PORT_OFFSET=100
